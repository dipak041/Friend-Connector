rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null && request.auth.token.email_verified == true; }
  function owns(field) { return signed() && resource.data[field] == request.auth.uid; }
  function actor(field) { return signed() && request.resource.data[field] == request.auth.uid; }
  function shortText(value, max) { return value is string && value.size() <= max; }
  function postExists(id) { return exists(/databases/$(database)/documents/posts/$(id)); }
  function profile() { let d=request.resource.data; return d.keys().hasOnly(['name','handle','bio','avatar','createdAt']) && shortText(d.name,50) && d.name.size()>0 && d.handle.matches('[a-z0-9_.]{3,24}') && shortText(d.bio,160) && shortText(d.avatar,2048) && d.createdAt is number; }
  function validNotification() {
   let d=request.resource.data;
   return (d.text == 'started following you.' && get(/databases/$(database)/documents/follows/$(d.eventId)).data.actorId == request.auth.uid && get(/databases/$(database)/documents/follows/$(d.eventId)).data.targetId == d.recipientId)
    || (d.text == 'liked your post.' && get(/databases/$(database)/documents/likes/$(d.eventId)).data.actorId == request.auth.uid && get(/databases/$(database)/documents/posts/$(get(/databases/$(database)/documents/likes/$(d.eventId)).data.postId)).data.authorId == d.recipientId)
    || (d.text == 'commented on your post.' && get(/databases/$(database)/documents/comments/$(d.eventId)).data.authorId == request.auth.uid && get(/databases/$(database)/documents/posts/$(get(/databases/$(database)/documents/comments/$(d.eventId)).data.postId)).data.authorId == d.recipientId);
  }
  function member() { return signed() && request.auth.uid in resource.data.members; }
  function description(d, type) { return d is map && d.keys().hasOnly(['type','sdp']) && d.type == type && shortText(d.sdp,100000); }
  match /calls/{id} {
   allow read: if member();
   allow create: if actor('callerId') && request.resource.data.keys().hasOnly(['callerId','calleeId','members','status','createdAt','expiresAt','offer'])
    && request.resource.data.calleeId != request.auth.uid
    && exists(/databases/$(database)/documents/users/$(request.resource.data.calleeId))
    && request.resource.data.members == [request.auth.uid,request.resource.data.calleeId]
    && request.resource.data.status == 'ringing'
    && request.resource.data.createdAt is number
    && request.resource.data.expiresAt > request.time.toMillis()
    && request.resource.data.expiresAt <= request.time.toMillis()+100000
    && description(request.resource.data.offer,'offer');
   allow update: if member() && (
    (request.auth.uid == resource.data.calleeId && resource.data.status == 'ringing' && resource.data.expiresAt > request.time.toMillis()
     && request.resource.data.status == 'accepted' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status']) && description(request.resource.data.answer,'answer'))
    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'ended' && resource.data.status in ['ringing','accepted'])
    || (request.auth.uid == resource.data.calleeId && resource.data.status == 'ringing' && request.resource.data.status == 'declined' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
   );
  }
  match /candidates/{id} {
   allow read: if member();
   allow create: if actor('senderId') && request.resource.data.keys().hasOnly(['callId','members','senderId','candidate','createdAt'])
    && request.resource.data.members == get(/databases/$(database)/documents/calls/$(request.resource.data.callId)).data.members
    && request.auth.uid in request.resource.data.members
    && get(/databases/$(database)/documents/calls/$(request.resource.data.callId)).data.status in ['ringing','accepted']
    && request.resource.data.candidate is map && shortText(request.resource.data.candidate.candidate,4096)
    && request.resource.data.createdAt is number;
  }
  match /users/{id} {
   allow read: if signed();
   allow create: if signed() && request.auth.uid == id && profile();
   allow update: if signed() && request.auth.uid == id && profile() && request.resource.data.createdAt == resource.data.createdAt;
  }
  match /posts/{id} {
   allow read: if signed();
   allow create: if actor('authorId') && request.resource.data.keys().hasOnly(['authorId','caption','media','mediaType','createdAt','kind','location']) && shortText(request.resource.data.caption,2200) && shortText(request.resource.data.media,2048) && shortText(request.resource.data.location,100) && request.resource.data.mediaType in ['image','video'] && request.resource.data.kind in ['post','reel'] && request.resource.data.createdAt is number;
   allow update: if owns('authorId') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption']) && shortText(request.resource.data.caption,2200);
   allow delete: if owns('authorId');
  }
  match /stories/{id} {
   allow read: if signed();
   allow create: if actor('authorId') && request.resource.data.keys().hasOnly(['authorId','caption','media','mediaType','createdAt','expiresAt']) && shortText(request.resource.data.caption,2200) && shortText(request.resource.data.media,2048) && request.resource.data.mediaType in ['image','video'] && request.resource.data.createdAt is number && request.resource.data.expiresAt > request.time.toMillis() && request.resource.data.expiresAt <= request.time.toMillis()+86460000;
   allow delete: if owns('authorId');
  }
  match /likes/{id} {
   allow read: if signed();
   allow create: if actor('actorId') && request.resource.data.keys().hasOnly(['actorId','postId','createdAt']) && id == request.auth.uid+'_'+request.resource.data.postId && postExists(request.resource.data.postId) && request.resource.data.createdAt is number;
   allow delete: if owns('actorId');
  }
  match /saves/{id} {
   allow read: if owns('actorId');
   allow create: if actor('actorId') && request.resource.data.keys().hasOnly(['actorId','postId','createdAt']) && id == request.auth.uid+'_'+request.resource.data.postId && postExists(request.resource.data.postId) && request.resource.data.createdAt is number;
   allow delete: if owns('actorId');
  }
  match /follows/{id} {
   allow read: if signed();
   allow create: if actor('actorId') && request.resource.data.keys().hasOnly(['actorId','targetId','createdAt']) && id == request.auth.uid+'_'+request.resource.data.targetId && request.resource.data.targetId != request.auth.uid && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId)) && request.resource.data.createdAt is number;
   allow delete: if owns('actorId');
  }
  match /comments/{id} {
   allow read: if signed();
   allow create: if actor('authorId') && request.resource.data.keys().hasOnly(['authorId','postId','text','createdAt']) && postExists(request.resource.data.postId) && shortText(request.resource.data.text,500) && request.resource.data.text.size()>0 && request.resource.data.createdAt is number;
   allow delete: if owns('authorId');
  }
  match /messages/{id} {
   allow read: if signed() && request.auth.uid in resource.data.members;
   allow create: if actor('authorId') && request.resource.data.keys().hasOnly(['chatId','members','authorId','text','createdAt']) && request.resource.data.members is list && request.resource.data.members.size()==2 && request.auth.uid in request.resource.data.members && request.resource.data.members[0] != request.resource.data.members[1] && request.resource.data.chatId in [request.resource.data.members[0]+'_'+request.resource.data.members[1],request.resource.data.members[1]+'_'+request.resource.data.members[0]] && shortText(request.resource.data.text,2000) && request.resource.data.text.size()>0 && request.resource.data.createdAt is number;
  }
  match /notifications/{id} {
   allow read: if owns('recipientId');
   allow create: if actor('actorId') && request.resource.data.keys().hasOnly(['actorId','recipientId','text','eventId','createdAt']) && exists(/databases/$(database)/documents/users/$(request.resource.data.recipientId)) && validNotification() && request.resource.data.createdAt is number;
   allow delete: if owns('recipientId');
  }
 }
}
