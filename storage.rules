rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /media/{userId}/{fileId} {
   allow read: if request.auth != null;
   allow create: if request.auth != null && request.auth.uid == userId && request.resource.size <= 20 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|gif)|video/(mp4|webm)');
   allow delete: if request.auth != null && request.auth.uid == userId;
  }
 }
}
